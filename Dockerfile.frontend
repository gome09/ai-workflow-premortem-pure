# Frontend runtime image — Streamlit UI only.
#
# Deliberately separate from the API image (Dockerfile): the UI container ships
# no api/core/graph/stages/storage source tree and no database/LLM drivers, so a
# compromised frontend process cannot reach PostgreSQL/Redis or reuse backend
# secrets. Runtime only receives API_BASE (+ demo flags) from compose.
#
# Dependencies come from the PEP 735 `frontend` group in pyproject.toml:
# `--only-group frontend` excludes psycopg / langchain / fastapi / alembic.
FROM ghcr.io/astral-sh/uv:0.11.12@sha256:3a59a3cdd5f7c217faa36e32dbc7fddbb0412889c2a0a5229f6d790e5a019dd7 AS uv

FROM python:3.11-slim AS deps

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/aiwf-venv

WORKDIR /app
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --only-group frontend

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/aiwf-venv/bin:${PATH}"

WORKDIR /app
COPY --from=deps /opt/aiwf-venv /opt/aiwf-venv
COPY frontend/ ./frontend/

RUN addgroup --system appgroup \
 && adduser --system --ingroup appgroup --no-create-home appuser \
 && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8501

CMD ["sh", "-c", "streamlit run frontend/app.py --server.port 8501 --server.address 0.0.0.0"]
