# Local environment and secrets. Docker Compose injects runtime values from the
# host; none of these files should ever enter the build context or image layer.
.env
.env.*
.envrc
.direnv/
secrets/
secrets.*
.streamlit/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Local virtual environments, caches, test output and generated data.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
junit*.xml
pytestdebug.log
test-results/
dist/
build/
*.egg-info/
.git/
.gitignore
.gitattributes
.DS_Store
postgres_data/
redis_data/
exports/
*.log
*.tmp
*.bak

# TLS certificates (generated at deploy time, never committed)
nginx/certs/

# Archived and legacy scripts — not part of production runtime
archive/
scripts/archive/

# SQLite data files (dev/test only)
data/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Live E2E test artifacts
artifacts/

# IDE and editor files
.idea/
.vscode/
.claude/
.agents/
.codex/
.cursor/
.windsurf/
*.swp
*.swo

# Repository governance, documentation, tests and deployment-only assets are
# not imported by the API/Streamlit runtime image. Keep examples/: scenario
# manifests load those Markdown samples at runtime.
.github/
docs/
tests/
scripts/
monitoring/
nginx/
/*.md
/*.html
/docker-compose*.yml
/Dockerfile
/.dockerignore

# project-upgrade:start
.upgrade/
# project-upgrade:end

# project-upgrade-maintainer:start
# Exclude upgrade workflow workspace from Docker build context by default
.upgrade/tmp
.upgrade/logs
.upgrade/archive
.upgrade/checkpoints
.upgrade/prompts
.upgrade/traces
.upgrade/transactions/*
!.upgrade/transactions/.gitkeep
# project-upgrade-maintainer:end
